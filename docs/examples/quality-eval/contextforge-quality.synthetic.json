  "trustOrderingCases": [
    {
      "id": "recent-handoff-before-durable-and-candidate",
      "sources": [
        { "id": "memory", "type": "durable_memory" },
        { "id": "checkpoint", "type": "recent_checkpoint", "ageHours": 1 },
