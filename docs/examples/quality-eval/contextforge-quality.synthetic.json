{
  "name": "contextforge-offline-quality",
  "retrievalFixtures": [
    "../workspace-eval/wastelite.synthetic.json",
    "multilingual-retrieval.synthetic.json"
  ],
  "distillationCases": [
    {
      "id": "operational-handoff-preservation",
      "rawEvidence": [
        {
          "id": "raw-1",
          "content": "2026-07-10 decision: keep SQLite at /srv/contextforge/contextforge.db because restore is local-first. Run node src/cli.js backupDatabase --file /srv/contextforge/backup.db every 6 hours. If free disk is below 104857600 bytes, stop pruning and report SQLITE_BUSY. Next action: verify /readyz before restart."
        }
      ],
      "expectedFacts": {
        "names": ["SQLite"],
        "numbers": ["2026-07-10", "6 hours", "104857600"],
        "paths": ["/srv/contextforge/contextforge.db", "/srv/contextforge/backup.db", "/readyz"],
        "commands": ["node src/cli.js backupDatabase --file /srv/contextforge/backup.db"],
        "errors": ["SQLITE_BUSY"],
        "decisions": ["keep SQLite"],
        "rationale": ["restore is local-first"],
        "conditions": ["free disk is below 104857600 bytes"],
        "nextActions": ["verify /readyz before restart"]
      },
      "requiredLiveStateWarnings": ["verify current disk space", "verify /readyz"],
      "requiredRetrievalHooks": ["/srv/contextforge/contextforge.db", "SQLITE_BUSY"],
      "forbiddenClaims": ["PostgreSQL", "automatic cloud upload"],
      "output": {
        "summaryShort": "Keep SQLite and verify backup/readiness before restart.",
        "summaryText": "2026-07-10 decision: keep SQLite at /srv/contextforge/contextforge.db because restore is local-first. Run node src/cli.js backupDatabase --file /srv/contextforge/backup.db every 6 hours. If free disk is below 104857600 bytes, stop pruning and report SQLITE_BUSY. Next action: verify /readyz before restart.",
        "liveStateWarnings": ["verify current disk space before pruning", "verify /readyz before restart"],
        "retrievalHooks": ["/srv/contextforge/contextforge.db", "SQLITE_BUSY"],
        "claims": [
          {
            "text": "Backup runs every 6 hours.",
            "sources": ["raw-1"],
            "requiredEvidenceTerms": ["every 6 hours", "backupDatabase"]
          }
        ]
      }
    },
    {
      "id": "truncated-window-retrieval-hook",
      "inputTruncated": true,
      "rawEvidence": [
        {
          "id": "raw-tail-42",
          "content": "Input window truncated. Resume exact investigation from raw-tail-42 and search for CONTEXTFORGE_SCHEMA_TOO_NEW before changing schema metadata."
        }
      ],
      "expectedFacts": {
        "errors": ["CONTEXTFORGE_SCHEMA_TOO_NEW"],
        "conditions": ["Input window truncated"],
        "nextActions": ["Resume exact investigation from raw-tail-42"]
      },
      "requiredLiveStateWarnings": ["verify schema version"],
      "requiredRetrievalHooks": ["raw-tail-42", "CONTEXTFORGE_SCHEMA_TOO_NEW"],
      "forbiddenClaims": ["downgrade is safe"],
      "output": {
        "summaryShort": "Truncated window requires raw evidence lookup.",
        "summaryText": "Input window truncated. Resume exact investigation from raw-tail-42 and search for CONTEXTFORGE_SCHEMA_TOO_NEW.",
        "liveStateWarnings": ["verify schema version before changing metadata"],
        "retrievalHooks": ["raw-tail-42", "CONTEXTFORGE_SCHEMA_TOO_NEW"],
        "claims": [
          {
            "text": "The input window was truncated.",
            "sources": ["raw-tail-42"],
            "requiredEvidenceTerms": ["window truncated", "raw-tail-42"]
          }
        ]
      }
    }
  ],
