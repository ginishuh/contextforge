# ContextForge remote server environment example.
# Copy this to a private env file such as /etc/contextforge/server.env or
# ~/.config/contextforge/server.env, then replace secrets and paths.

CONTEXTFORGE_REMOTE_HOST=127.0.0.1
CONTEXTFORGE_REMOTE_PORT=8765
CONTEXTFORGE_REMOTE_TOKEN=change-me

# Optional least-privilege API tokens. Secrets stay in dedicated env variables;
# the JSON policy contains only their env names (or a SHA-256 hash), capabilities,
# scope rules, expiry, and revocation state. When policies are present the legacy
# REMOTE_TOKEN is disabled unless LEGACY_REMOTE_TOKEN_MODE=full is explicit.
# CONTEXTFORGE_REPO_READER_TOKEN=replace-with-a-long-random-secret
# CONTEXTFORGE_API_TOKENS_JSON=[{"id":"repo-reader","tokenEnv":"CONTEXTFORGE_REPO_READER_TOKEN","capabilities":["read"],"scopes":["repo:github.com/example/contextforge"]}]
# CONTEXTFORGE_LEGACY_REMOTE_TOKEN_MODE=disabled

# MCP defaults to the bounded `agent-core` surface. Dedicated review/operator/
# workspace-admin servers may select another profile. Use `all` only for
# compatibility with clients that require the former full tool surface.
CONTEXTFORGE_MCP_PROFILE=agent-core
# An exact comma-separated allowlist overrides the profile.
# CONTEXTFORGE_MCP_TOOLS=db_info,bootstrap_context,search

# Optional admin UI login at /ui/. Password login is disabled unless both values
# are configured. The password value uses PBKDF2 format:
# iterations:saltHex:hashHex
# CONTEXTFORGE_ADMIN_USER=admin
# CONTEXTFORGE_ADMIN_PASSWORD_PBKDF2=

# Forwarded headers are ignored by default. Set the direct reverse proxy IP/CIDR
# list only when that proxy overwrites client-supplied X-Forwarded-For and
# X-Forwarded-Proto. Use `loopback` for a proxy on this machine. Avoid `true`
# unless the ContextForge port is unreachable except through the proxy.
# CONTEXTFORGE_TRUST_PROXY=127.0.0.1/32,::1/128
# CONTEXTFORGE_ADMIN_LOGIN_MAX_KEYS=10000

# Server storage controls where the remote server keeps canonical data.
# Use `local` for a normal single-server SQLite deployment with DATA_DIR below.
# Do not set this to `remote` for the server process itself.
CONTEXTFORGE_SERVER_STORAGE_MODE=local
CONTEXTFORGE_DATA_DIR=/var/lib/contextforge

# Readiness and graceful shutdown thresholds. /healthz is liveness only;
# /readyz checks DB/schema, disk, queues, and enabled embedding failures.
CONTEXTFORGE_READINESS_MIN_FREE_BYTES=104857600
CONTEXTFORGE_READINESS_MAX_QUEUED_JOBS=1000
CONTEXTFORGE_SHUTDOWN_TIMEOUT_MS=30000

# Raw evidence is kept for this many days before pruning. Durable memories and
# distilled checkpoints are preserved separately.
CONTEXTFORGE_RAW_TTL_DAYS=30

# Distillation turns raw evidence into checkpoints and promotion candidates.
# `codex_exec` requires the configured Codex CLI to be authenticated on the
# server host.
CONTEXTFORGE_DISTILL_PROVIDER=codex_exec
CONTEXTFORGE_CODEX_EXEC_MODEL=gpt-5.4-mini
CONTEXTFORGE_CODEX_EXEC_REASONING_EFFORT=low

# OpenAI-compatible distillation provider defaults for DeepSeek. These can also
# be changed at runtime through the admin UI and are hot-applied to new
# distillation calls.
CONTEXTFORGE_OPENAI_COMPATIBLE_PRESET=deepseek
CONTEXTFORGE_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
CONTEXTFORGE_OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
CONTEXTFORGE_OPENAI_COMPATIBLE_RESPONSE_FORMAT=json_object
CONTEXTFORGE_OPENAI_COMPATIBLE_API_KEY=sk-...
# Runtime secrets saved through the UI/API are plaintext in SQLite and disabled
# by default. Prefer the environment variable above. Enable only as an explicit
# compatibility opt-in for a trusted single-user store.
# CONTEXTFORGE_ALLOW_PLAINTEXT_RUNTIME_SECRETS=true

# Embeddings are required for high-quality semantic retrieval. Keep the OpenAI
# key on the server/worker process, not on remote clients.
CONTEXTFORGE_EMBEDDINGS_PROVIDER=openai
CONTEXTFORGE_OPENAI_API_KEY=sk-...
CONTEXTFORGE_EMBEDDINGS_MODEL=text-embedding-3-small
CONTEXTFORGE_EMBEDDINGS_DIMENSIONS=1536
CONTEXTFORGE_EMBEDDINGS_TIMEOUT_MS=30000

# Stuck embedding jobs are reset from `processing` to `pending` after this
# interval. The default is 10 minutes.
CONTEXTFORGE_EMBEDDINGS_STALE_AFTER_MS=600000

# Auto-promotion is off in the public example. Set to true only in an
# intentional trusted deployment where closeout-scoped safe candidates should be
# allowed to promote with dryRun=false. The tool still requires sessionId or
# checkpointId, never scans scope-wide backlog, excludes preference candidates,
# applies strict confidence/stability/sensitivity/duplicate checks, and runs a
# separate Codex audit gate before writing durable memory.
CONTEXTFORGE_AUTO_PROMOTE_ENABLED=false
CONTEXTFORGE_AUTO_PROMOTE_AUDIT_ENABLED=true
CONTEXTFORGE_AUTO_PROMOTE_AUDIT_PROVIDER=codex_exec
CONTEXTFORGE_AUTO_PROMOTE_AUDIT_CODEX_MODEL=gpt-5.5
CONTEXTFORGE_AUTO_PROMOTE_AUDIT_CODEX_REASONING_EFFORT=low

# Experimental alternative: run the audit gate through the Codex Python SDK
# while using an existing local Codex binary instead of the SDK's pinned
# runtime wheel.
# CONTEXTFORGE_AUTO_PROMOTE_AUDIT_PROVIDER=codex_sdk_python
# CONTEXTFORGE_AUTO_PROMOTE_AUDIT_CODEX_BIN=/home/ubuntu/.local/bin/codex
# CONTEXTFORGE_AUTO_PROMOTE_AUDIT_PYTHON_COMMAND=python3
# CONTEXTFORGE_AUTO_PROMOTE_AUDIT_PYTHONPATH=/opt/contextforge/openai-codex-sdk
